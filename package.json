{
  "name": "react-app-boilerplate",
  "version": "1.0.0",
  "description": "A lightweight React app boilerplate that provides a clean, modern starting point for building web applications",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "webpack serve --open --mode development --config webpack.dev.js",
    "build": "webpack --mode production --config webpack.prod.js",
    "prepare": "husky",
    "code-lint": "eslint ./src --ext .ts,.tsx,.js,.jsx",
    "style-lint": "stylelint ./src/**/*.css",
    "lint": "npm run code-lint && npm run style-lint",
    "prettier-check": "prettier --check ./src",
    "prettier-fix": "prettier --write ./src",
    "type-check": "tsc --noEmit",
    "test": "jest --coverage",
    "pre-commit": "npm run lint && npm run prettier-check",
    "pre-push": "npm run type-check && npm run test"
  },
  "author": "Khrystyna Pylypets",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint-react/eslint-plugin": "^2.6.4",
    "@eslint/js": "^9.39.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "webpack": "^5.102.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1",
    "webpack-stats-plugin": "^1.1.3"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "core-js": "^3.46.0",
    "lodash": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
